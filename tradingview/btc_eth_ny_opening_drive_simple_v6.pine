//@version=6
strategy("BTC ETH New York Opening Drive", overlay=true, initial_capital=100000, pyramiding=0, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.059, slippage=0, margin_long=100, margin_short=100, process_orders_on_close=false)

// Use this strategy on a standard 15-minute BTC or ETH chart.
// Times use America/New_York and automatically adjust for daylight saving.

atrLength = input.int(14, "ATR length", minval=2)
minimumScore = input.float(1.25, "Minimum drive score", minval=0.25, step=0.05)
stopAtr = input.float(2.0, "Stop distance in ATR", minval=0.25, step=0.25)
rewardRisk = input.float(2.0, "Reward/risk", minval=0.5, step=0.25)
allowLongs = input.bool(true, "Allow longs")
allowShorts = input.bool(true, "Allow shorts")
diagnosticMode = input.bool(false, "Diagnostic mode: take every non-flat opening drive", tooltip="Enable temporarily if Strategy Tester shows no trades. Disable for the researched 1.25-score rule.")

sessionTimezone = "America/New_York"
openingSession = "0930-1000:1234567"
decisionSession = "0945-1000:1234567"
exitSession = "1545-1600:1234567"

inOpeningWindow = not na(time(timeframe.period, openingSession, sessionTimezone))
openingWindowStarted = inOpeningWindow and not inOpeningWindow[1]
decisionBar = not na(time(timeframe.period, decisionSession, sessionTimezone))
timeExitBar = not na(time(timeframe.period, exitSession, sessionTimezone))

atr = ta.atr(atrLength)
var float openingPrice = na
var bool tradedThisSession = false
var float lastDriveScore = na
var int eligibleSetups = 0

if openingWindowStarted
    openingPrice := open
    tradedThisSession := false

driveScore = decisionBar and not na(openingPrice) and atr > 0 ? math.abs(close - openingPrice) / (atr * math.sqrt(2.0)) : na
driveLong = decisionBar and not na(openingPrice) and close > openingPrice
driveShort = decisionBar and not na(openingPrice) and close < openingPrice

if decisionBar and not na(driveScore)
    lastDriveScore := driveScore

stopDistance = atr * stopAtr
stopTicks = math.max(1, int(math.round(stopDistance / syminfo.mintick)))
targetTicks = math.max(1, int(math.round(stopDistance * rewardRisk / syminfo.mintick)))
scorePassed = diagnosticMode ? driveScore > 0 : driveScore >= minimumScore
validSetup = decisionBar and not na(driveScore) and scorePassed and not tradedThisSession and strategy.position_size == 0
longSetup = validSetup and driveLong and allowLongs
shortSetup = validSetup and driveShort and allowShorts

if longSetup
    tradedThisSession := true
    eligibleSetups += 1
    strategy.entry("Long", strategy.long)
    strategy.exit("Long exit", from_entry="Long", loss=stopTicks, profit=targetTicks)

if shortSetup
    tradedThisSession := true
    eligibleSetups += 1
    strategy.entry("Short", strategy.short)
    strategy.exit("Short exit", from_entry="Short", loss=stopTicks, profit=targetTicks)

if timeExitBar and strategy.position_size != 0
    strategy.close_all(comment="16:00 New York exit", immediately=true)

correctTimeframe = timeframe.isminutes and timeframe.multiplier == 15
bgcolor(inOpeningWindow ? color.new(color.blue, 88) : na, title="09:30-10:00 New York")
plot(inOpeningWindow ? openingPrice : na, title="Opening price", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(driveScore, title="Drive score", color=color.blue, display=display.data_window)
plotshape(decisionBar, title="Daily decision bar", style=shape.circle, location=location.bottom, color=color.gray, size=size.tiny)
plotshape(longSetup, title="Long setup", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="LONG")
plotshape(shortSetup, title="Short setup", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SHORT")

var table diagnostics = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.cell(diagnostics, 0, 0, "Strategy status", bgcolor=color.navy, text_color=color.white)
    table.cell(diagnostics, 1, 0, "Loaded", bgcolor=color.navy, text_color=color.white)
    table.cell(diagnostics, 0, 1, "Symbol")
    table.cell(diagnostics, 1, 1, syminfo.ticker)
    table.cell(diagnostics, 0, 2, "Timeframe")
    table.cell(diagnostics, 1, 2, timeframe.period, text_color=correctTimeframe ? color.lime : color.red)
    table.cell(diagnostics, 0, 3, "Last drive score")
    table.cell(diagnostics, 1, 3, na(lastDriveScore) ? "No 09:45 bar loaded" : str.tostring(lastDriveScore, "#.##"))
    table.cell(diagnostics, 0, 4, "Eligible setups")
    table.cell(diagnostics, 1, 4, str.tostring(eligibleSetups))
    table.cell(diagnostics, 0, 5, "Mode")
    table.cell(diagnostics, 1, 5, diagnosticMode ? "Diagnostic" : "Score >= " + str.tostring(minimumScore))

if barstate.islast and not correctTimeframe
    label.new(bar_index, high, "Change chart to 15 minutes", style=label.style_label_down, color=color.red, textcolor=color.white)
